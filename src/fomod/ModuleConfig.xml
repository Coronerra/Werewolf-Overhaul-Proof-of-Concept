<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
 <moduleName>Female Werewolf ABC HDT MFA v1.2</moduleName>
 <requiredInstallFiles><folder source="common" destination=""/><file source="README_v1.2.txt" destination="README_FemaleWerewolf_v1.2.txt"/></requiredInstallFiles>
 <installSteps order="Explicit">
  <installStep name="Fur style"><optionalFileGroups order="Explicit"><group name="Fur style (both genders)" type="SelectExactlyOne"><plugins order="Explicit">
   <plugin name="Smooth"><description>Same as v1.1: ABC male (vanilla fur cards) and HDT female, no shell fur.</description><conditionFlags><flag name="body">smooth</flag></conditionFlags><typeDescriptor><type name="Recommended"/></typeDescriptor></plugin>
   <plugin name="Fluffy"><description>Adds 10 Fluffworks-style fur shell layers to the male and female bodies (heavier on performance).</description><conditionFlags><flag name="body">fluffy</flag></conditionFlags><typeDescriptor><type name="Optional"/></typeDescriptor></plugin>
  </plugins></group></optionalFileGroups></installStep>
  <installStep name="Female body"><optionalFileGroups order="Explicit"><group name="Female werewolf body (HDT MFA and Growl Patch)" type="SelectExactlyOne"><plugins order="Explicit">
   <plugin name="Default"><description>Default female body.</description><conditionFlags><flag name="fem">Default</flag></conditionFlags><typeDescriptor><type name="Recommended"/></typeDescriptor></plugin>
   <plugin name="2T"><description>2T female body.</description><conditionFlags><flag name="fem">2T</flag></conditionFlags><typeDescriptor><type name="Optional"/></typeDescriptor></plugin>
   <plugin name="6T"><description>6T female body.</description><conditionFlags><flag name="fem">6T</flag></conditionFlags><typeDescriptor><type name="Optional"/></typeDescriptor></plugin>
  </plugins></group></optionalFileGroups></installStep>
 </installSteps>
 <conditionalFileInstalls><patterns>
   <pattern><dependencies operator="And"><flagDependency flag="body" value="smooth"/><flagDependency flag="fem" value="Default"/></dependencies><files><file source="esp\smooth_Default\FemaleWerewolf_ABC_HDT_MFA.esp" destination="FemaleWerewolf_ABC_HDT_MFA.esp"/></files></pattern>
   <pattern><dependencies operator="And"><flagDependency flag="body" value="smooth"/><flagDependency flag="fem" value="2T"/></dependencies><files><file source="esp\smooth_2T\FemaleWerewolf_ABC_HDT_MFA.esp" destination="FemaleWerewolf_ABC_HDT_MFA.esp"/></files></pattern>
   <pattern><dependencies operator="And"><flagDependency flag="body" value="smooth"/><flagDependency flag="fem" value="6T"/></dependencies><files><file source="esp\smooth_6T\FemaleWerewolf_ABC_HDT_MFA.esp" destination="FemaleWerewolf_ABC_HDT_MFA.esp"/></files></pattern>
   <pattern><dependencies operator="And"><flagDependency flag="body" value="fluffy"/><flagDependency flag="fem" value="Default"/></dependencies><files><file source="esp\fluffy_Default\FemaleWerewolf_ABC_HDT_MFA.esp" destination="FemaleWerewolf_ABC_HDT_MFA.esp"/><folder source="fluffy" destination=""/></files></pattern>
   <pattern><dependencies operator="And"><flagDependency flag="body" value="fluffy"/><flagDependency flag="fem" value="2T"/></dependencies><files><file source="esp\fluffy_2T\FemaleWerewolf_ABC_HDT_MFA.esp" destination="FemaleWerewolf_ABC_HDT_MFA.esp"/><folder source="fluffy" destination=""/></files></pattern>
   <pattern><dependencies operator="And"><flagDependency flag="body" value="fluffy"/><flagDependency flag="fem" value="6T"/></dependencies><files><file source="esp\fluffy_6T\FemaleWerewolf_ABC_HDT_MFA.esp" destination="FemaleWerewolf_ABC_HDT_MFA.esp"/><folder source="fluffy" destination=""/></files></pattern>
 </patterns></conditionalFileInstalls>
</config>
